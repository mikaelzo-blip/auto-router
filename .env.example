PORT=20200
HOST=127.0.0.1
UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1
# Set this in your environment. Never commit the actual value.
UPSTREAM_API_KEY=

# Optional: ask this upstream model to classify only ambiguous requests.
# Leave empty to use the deterministic fallback.
CLASSIFIER_MODEL=
CLASSIFIER_TIMEOUT_MS=5000
UPSTREAM_CONNECT_TIMEOUT_MS=30000
UPSTREAM_HEADER_TIMEOUT_MS=60000
UPSTREAM_FIRST_BYTE_TIMEOUT_MS=120000
UPSTREAM_STREAM_IDLE_TIMEOUT_MS=30000
ROUTING_CONFIG=./config/routes.json
LOG_LEVEL=info

# Router mode: legacy | shadow | v2 (default legacy)
ROUTER_MODE=v2
# Reasoning policy: passthrough | auto | shadow (default passthrough)
REASONING_POLICY=auto
# Quota policy: off | shadow | auto (default off)
QUOTA_POLICY=auto
# Promote the agentic primary model for agentic requests
SONNET_AGENTIC_ENABLED=true
