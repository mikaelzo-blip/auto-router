PORT=20200
HOST=127.0.0.1
UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1
# Set this in your environment. Never commit the actual value.
UPSTREAM_API_KEY=

# Optional: ask this upstream model to classify only ambiguous requests.
# Leave empty to use the deterministic fallback.
CLASSIFIER_MODEL=
CLASSIFIER_TIMEOUT_MS=5000
UPSTREAM_TIMEOUT_MS=120000
ROUTING_CONFIG=./config/routes.json
LOG_LEVEL=info
