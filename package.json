{
  "name": "auto-router",
  "version": "1.0.0",
  "private": true,
  "description": "Local OpenAI-compatible semantic router for 9Router",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "bash scripts/setup.sh",
    "health": "bash scripts/health-check.sh"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
